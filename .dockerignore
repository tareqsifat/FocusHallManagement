.git
.gitignore
.gitattributes
.editorconfig
.env
.env.*
!.env.example
Dockerfile
.dockerignore

/vendor
/node_modules
/public/build
/public/hot
/public/storage

# Locally generated caches (list dev-only providers) and runtime state
/bootstrap/cache/*.php
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/private/*
/storage/app/public/*
/storage/framework/cache/data/*
/storage/framework/views/*.php
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/pail
/database/*.sqlite

.phpunit.result.cache
/.phpunit.cache
*.log

# Not needed at runtime (server-side deploy files come from the git checkout)
/.github
/tests
/docs
*.md
phpunit.xml
docker-compose*.yml
deploy.sh
/bin
/docker/proxy
/docker/caddy
