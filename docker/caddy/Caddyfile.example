# Copy to docker/caddy/Caddyfile (not in git) and keep the variant you need.
# Caddy terminates HTTPS and forwards everything to the proxy, which routes
# to the app. SITE_HOST comes from .env.
#
# Reload after editing, without downtime:
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

# --- Domain (e.g. SITE_HOST=hall.example.com) --------------------------------------
{$SITE_HOST} {
	encode zstd gzip
	reverse_proxy proxy:80
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

# --- IP address only (SITE_HOST=YOUR_IP): use this instead of the above -------
# {
# 	# Browsers send no SNI for an IP, so tell Caddy which certificate to use
# 	default_sni {$SITE_HOST}
